{
  "title": "OTTx",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "3-band multiband",
        "upward + downward",
        "compressor.",
        "",
        "A faithful port of",
        "vitOTTx (Vital's OTT",
        "DSP).",
        "",
        "GPLv3."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 Mix",
        "2 Depth",
        "3 Upward",
        "4 Downward",
        "5 Time",
        "6 In Gain",
        "7 Out Gain",
        "8 Tame"
      ]
    },
    {
      "title": "Tame",
      "lines": [
        "Keeps upward",
        "compression from",
        "boosting hiss.",
        "0 dB: ignores 16-bit",
        "residue (default).",
        "Up to +12: tames",
        "noisy lo-fi sources.",
        "-12: off (original)."
      ]
    },
    {
      "title": "Advanced",
      "lines": [
        "Per-band thresholds,",
        "ratios, output gain,",
        "and the two crossover",
        "frequencies.",
        "",
        "Depth scales all band",
        "ratios at once."
      ]
    }
  ]
}
